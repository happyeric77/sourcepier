{
  "name": "sourcepier",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./index.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./rpc.ts"
  },
  "scripts": {
    "build:tui": "bun scripts/build-tui.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:package": "bun test tests/unit/package.test.ts"
  },
  "overrides": {
    "seroval": "1.6.9"
  },
  "devDependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/bun": "^1.4.3",
    "@types/node": "^22.15.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3"
  },
  "description": "SourcePier: project-scoped Markdown document management for OpenCode v2",
  "keywords": [
    "sourcepier",
    "opencode",
    "opencode-v2",
    "plugin",
    "markdown",
    "sources"
  ],
  "files": [
    "index.ts",
    "rpc.ts",
    "tui.ts",
    "src/",
    "dist/",
    "tsconfig.json"
  ],
  "dependencies": {
    "@opencode/plugin": "2.0.26"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happyeric77/sourcepier.git"
  },
  "homepage": "https://github.com/happyeric77/sourcepier#readme",
  "bugs": {
    "url": "https://github.com/happyeric77/sourcepier/issues"
  }
}
